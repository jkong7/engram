{
  "name": "engram",
  "version": "0.1.0",
  "description": "Durable personal memory for any AI agent harness: MCP server, hooks, transcript ingestion, hybrid recall",
  "type": "module",
  "private": true,
  "bin": { "engram": "bin/engram.js" },
  "engines": { "node": ">=23.6" },
  "scripts": {
    "test": "node --test --test-concurrency=1 test/*.test.ts",
    "typecheck": "tsc -p tsconfig.json",
    "start": "node src/cli.ts daemon run"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "2.3.1",
    "zod": "4.6.5"
  },
  "optionalDependencies": {
    "@huggingface/transformers": "4.3.1"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^6.0.0"
  }
}
